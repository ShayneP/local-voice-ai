# Local-only LiveKit dev defaults — override LIVEKIT_URL to point at LiveKit Cloud.
# Pointing LIVEKIT_URL off-box also stops the supervisor managing its own
# server, which is what you want for LiveKit Cloud.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# To reach a locally managed server from another machine, set only this to the
# host's LAN address. It changes what browsers are told to connect to, and the
# ICE address follows it, while LIVEKIT_URL stays on loopback so the server is
# still started here.
# LIVEKIT_PUBLIC_URL=ws://192.168.1.40:7880

# LLM (llama.cpp server is a managed subprocess by default)
LLAMA_BASE_URL=http://127.0.0.1:11434/v1
LLAMA_MODEL=gemma-4-e2b
LLAMA_MODEL_ALIAS=gemma-4-e2b
LLAMA_HF_REPO=unsloth/gemma-4-E2B-it-qat-GGUF:UD-Q4_K_XL
# Offline use: once the model is cached, it starts with no internet
# automatically. Force it with LLAMA_OFFLINE=1 (or LLAMA_OFFLINE=0 to always
# re-check Hugging Face), or set LLAMA_MODEL_PATH to load a local .gguf directly.
# LLAMA_OFFLINE=1
# LLAMA_MODEL_PATH=/models/gemma-4-E2B-it-qat-UD-Q4_K_XL.gguf
LLAMA_CTX_SIZE=4096
# LLAMA_N_GPU_LAYERS: CPU default is 0; the GPU overlay defaults to 999 (full
# offload). Set it here only to force a specific value in both modes.
# Audio-in half-cascade (Gemma-4 12B): set LLM_AUDIO_INPUT=1 to feed mic audio
# straight into an audio-capable LLM and drop the STT service. See README.
# LLM_AUDIO_INPUT=1

# STT (native streaming Nemotron Q8 is the default; use whisper as a fallback)
STT_PROVIDER=nemotron-cpp
STT_LANGUAGE=en
STT_BASE_URL=http://127.0.0.1:8000/v1
STT_MODEL=nemotron-speech-streaming
STT_API_KEY=no-key-needed
# Selects the English model for English and the multilingual model otherwise.
NEMOTRON_CPP_MODEL=auto
# NEMO_SPEECH_BIN=nemo-speech
# NEMOTRON_CPP_GPU=0

# Legacy Python Nemotron service (STT_PROVIDER=nemotron)
NEMOTRON_MODEL_NAME=nvidia/nemotron-speech-streaming-en-0.6b
NEMOTRON_MODEL_ID=nemotron-speech-streaming

# TTS (Kokoro). Use kokoro-onnx for the lower-memory ONNX runtime.
TTS_PROVIDER=kokoro
TTS_BASE_URL=http://127.0.0.1:8880/v1
TTS_VOICE=af_nova

# Agent endpointing and worker pool. The Jetson lean profile uses VAD-only
# endpointing and one idle process to preserve unified-memory headroom.
TURN_DETECTION=multilingual
# AGENT_IDLE_PROCESSES=1

# Web (FastAPI: token route + static frontend)
WEB_PORT=8080
# Extra HTTPS origins for separately hosted clients. Localhost works by default.
# CLIENT_ORIGINS=https://voice.example

# Optional Whisper fallback (STT_PROVIDER=whisper)
WHISPER_MODEL=Systran/faster-whisper-small

# Wake word: set WAKE_WORD=1 to make the agent listen only after "hey livekit".
# Detection scores are logged (log level DEBUG) — tune WAKE_WORD_THRESHOLD to
# your microphone if needed.
# WAKE_WORD=1
# WAKE_WORD_THRESHOLD=0.5
